share_2324 <- shares %>% filter(period == "2023–2024") %>% pull(share)
share_2025  <- shares %>% filter(period == "2025") %>% pull(share)
share_0019  <- shares %>% filter(period == "2012-2019") %>% pull(share)
subtitle_text <- paste0(
"CES Survey Jobs Data, Total Nonfarm. Women gained ",
percent(share_2025, accuracy = 0.1),
" of net job gains in 2025 YTD vs ",
percent(share_2324, accuracy = 0.1),
" in 2023–2024"
)
# ---- Plot ----
plot_df <- gender %>%
filter(year(date) >= 2023) %>%
pivot_longer(c(diff_men, diff_women),
names_to = "gender",
values_to = "jobs") %>%
mutate(gender = recode(gender,
diff_men = "Men",
diff_women = "Women"))
plot_df %>%
ggplot(aes(x = date, y = jobs, fill = gender)) +
geom_col(position = "stack") +
geom_text(
data = plot_df %>% filter(year(date) == 2025),
aes(label = comma(round(jobs))),
position = position_stack(vjust = 0.5),
color = "white",
size = 3.2
) +
scale_fill_manual(values = c("Men" = "#2c3254", "Women" = "#ff8361")) +
labs(
title = "Monthly Change in Payroll Jobs by Gender",
subtitle = subtitle_text,
x = NULL, y = NULL,
fill = NULL
) +
theme_esp() +
theme(legend.position = "right") +
scale_x_date(date_labels = "%b\n%Y", breaks = MI_dates)
library(dplyr)
library(tidyr)
library(lubridate)
library(ggplot2)
library(scales)
# optional but handy if you prefer glue-style strings:
# library(glue)
gender_df <- get_n_series_table(
c("CES0000000010", "CES0000000001"),
api_key = bls_get_key(),
start_year = 1999,
end_year = 2025,
tidy = TRUE
)
gender <- gender_df %>%
mutate(
diff_total = CES0000000001 - lag(CES0000000001, 1),
diff_women = CES0000000010 - lag(CES0000000010, 1),
diff_men   = diff_total - diff_women,
share_women = diff_women / diff_total,
date = as.Date(paste0(year,"/",month,"/",1))
)
MI_dates <- sort(unique(gender$date), decreasing = TRUE)
MI_dates <- MI_dates[seq(1, length(MI_dates), 6)]
# ---- Compute shares for 2025 YTD and 2023–2024 combined ----
shares <- gender %>%
mutate(period = case_when(
year(date) %in% c(2023, 2024) ~ "2023–2024",
year(date) >= 2025 & month(date) >= 2 ~ "2025",
year(date) >= 2012 & year(date) <= 2019 ~ "2012-2019",
TRUE ~ NA_character_
)) %>%
filter(!is.na(period)) %>%
group_by(period) %>%
summarise(
women = sum(diff_women, na.rm = TRUE),
total = sum(diff_total, na.rm = TRUE),
.groups = "drop"
) %>%
mutate(share = ifelse(total == 0, NA_real_, women / total))
share_2324 <- shares %>% filter(period == "2023–2024") %>% pull(share)
share_2025  <- shares %>% filter(period == "2025") %>% pull(share)
share_0019  <- shares %>% filter(period == "2012-2019") %>% pull(share)
subtitle_text <- paste0(
"CES Survey Jobs Data, Total Nonfarm. Women gained ",
percent(share_2025, accuracy = 0.1),
" of net job gains in 2025, Feb to YTD, vs ",
percent(share_2324, accuracy = 0.1),
" in 2023–2024"
)
# ---- Plot ----
plot_df <- gender %>%
filter(year(date) >= 2023) %>%
pivot_longer(c(diff_men, diff_women),
names_to = "gender",
values_to = "jobs") %>%
mutate(gender = recode(gender,
diff_men = "Men",
diff_women = "Women"))
plot_df %>%
ggplot(aes(x = date, y = jobs, fill = gender)) +
geom_col(position = "stack") +
geom_text(
data = plot_df %>% filter(year(date) == 2025),
aes(label = comma(round(jobs))),
position = position_stack(vjust = 0.5),
color = "white",
size = 3.2
) +
scale_fill_manual(values = c("Men" = "#2c3254", "Women" = "#ff8361")) +
labs(
title = "Monthly Change in Payroll Jobs by Gender",
subtitle = subtitle_text,
x = NULL, y = NULL,
fill = NULL
) +
theme_esp() +
theme(legend.position = "right") +
scale_x_date(date_labels = "%b\n%Y", breaks = MI_dates)
library(tidyverse)
library(ggtext)
library(blsR)
library(tidyusmacro)
library(scales)
library(zoo)
library(tidyverse)
library(lubridate)
library(viridis)
date_breaks_gg()
##### TITLES #####
title1 <- "Unemployment Picks Up in July"
title2 <- "Revisions Wipe Out Job Gains in Recent Months"
title3 <- "Only Half of Industries Are Adding Jobs"
bls_api <- "996d4e4af85f43f3ac301805891cbf6e"
bls_set_key(bls_api)
positive_color <- "#2c3254" # Bright blue
negative_color <- "#ff8361" # Pale violet
unrate <- get_n_series_table(
c("LNS13000000","LNS11000000","CES0500000021","CES0000000001"),
api_key = bls_get_key(),
start_year = 2011,
end_year = 2025,
tidy = TRUE
)
unrate <- unrate %>%
mutate(unrate = LNS13000000/LNS11000000,
date = as.Date(paste0(year,"/",month,"/",1)),
diffusion = CES0500000021/100,
ces = CES0000000001 - lag(CES0000000001,1))
# Unemployment Rate ----
unrate %>%
filter(date > max(date) %m-% months(24)) %>%
mutate(dateTag = if_else(date >= max(date) %m-% months(2), round(unrate, 4), NA)) %>%
ggplot(aes(date, unrate, label = percent(dateTag, 0.01))) +
geom_line(size = 1.2, color=positive_color) +
geom_text(aes(date, dateTag), nudge_x = 25, color=positive_color) +
geom_point(aes(date, dateTag), size = 4, color=positive_color) +
scale_y_continuous(label = percent) +
theme_esp() +
labs(
title = title1,
subtitle = "Unemployment Rate, Manually Calculated",
caption = "Mike Konczal"
) +
scale_x_date(date_labels = "%b\n%Y", breaks = date_breaks_gg(date, 6))
# Unemployment Rate ----
unrate %>%
filter(date > max(date) %m-% months(24)) %>%
mutate(dateTag = if_else(date >= max(date) %m-% months(2), round(unrate, 4), NA)) %>%
ggplot(aes(date, unrate, label = percent(dateTag, 0.01))) +
geom_line(size = 1.2, color=positive_color) +
geom_text(aes(date, dateTag), nudge_x = 25, color=positive_color) +
geom_point(aes(date, dateTag), size = 4, color=positive_color) +
scale_y_continuous(label = percent) +
theme_esp() +
labs(
title = title1,
subtitle = "Unemployment Rate, Manually Calculated",
caption = "Mike Konczal"
) +
scale_x_date(date_labels = "%b\n%Y", breaks = date_breaks_gg(6))
# Unemployment Rate ----
unrate %>%
filter(date > max(date) %m-% months(24)) %>%
mutate(dateTag = if_else(date >= max(date) %m-% months(2), round(unrate, 4), NA)) %>%
ggplot(aes(date, unrate, label = percent(dateTag, 0.01))) +
geom_line(size = 1.2, color=positive_color) +
geom_text(aes(date, dateTag), nudge_x = 25, color=positive_color) +
geom_point(aes(date, dateTag), size = 4, color=positive_color) +
scale_y_continuous(label = percent) +
theme_esp() +
labs(
title = title1,
subtitle = "Unemployment Rate, Manually Calculated",
caption = "Mike Konczal"
) +
scale_x_date(date_labels = "%b\n%Y", breaks = date_breaks_gg(24))
# Unemployment Rate ----

# NBER recessions since 1990
recessions <- tribble(
~start,        ~end,
"1990-07-01",  "1991-03-01",
"2001-03-01",  "2001-11-01",
"2007-12-01",  "2009-06-01",
"2020-02-01",  "2020-04-01"
) %>%
mutate(across(everything(), ymd))
ces_data %>%
filter(industry_name == "Temporary help services",
seasonal == "S",
data_type_code == "01") %>%
ggplot(aes(date, value)) +
## recession shading ------------
geom_rect(
data = recessions,
aes(xmin = start, xmax = end, ymin = -Inf, ymax = Inf),
inherit.aes = FALSE,
fill = "grey50",   # opaque grey
alpha = 0.25       # tweak opacity to taste
) +
## main series ------------------
geom_line(size = 1) +
labs(
subtitle = "Total employment: Temporary help services · Monthly, thousands · Seasonally adjusted (CES)",
title     = "What’s going on with temp help in this recovery?",
caption   = "Mike Konczal",
x = NULL, y = NULL
) +
theme_classic(base_size = 18) +
theme(plot.title.position = "plot")
ggplot(ces_filtered, aes(date, value)) +
geom_rect(data = recessions, aes(xmin = start, xmax = end, ymin = -Inf, ymax = Inf),
fill = "grey50", alpha = .12, inherit.aes = FALSE) +
geom_line(size = 1.1, colour = "#2c3254") +
geom_point(data = . %>% filter(date == max(date)), size = 3, colour = "#ff8361") +
geom_hline(yintercept = 0, linetype = "dotted", linewidth = .25) +
labs(
title    = "What’s going on with temp help in this recovery?",
subtitle = "Total employment in Temporary Help Services (thousands, SA, CES)",
caption  = "Source: BLS CES | Graphic: Mike Konczal",
x = NULL, y = NULL
) +
scale_x_date(breaks = scales::breaks_width("5 years"),
labels = scales::date_format("%Y")) +
theme_classic(base_family = "Source Sans Pro", base_size = 18) +
theme(
plot.title.position = "plot",
plot.subtitle       = element_text(hjust = 0),
panel.grid.major.x  = element_blank(),
panel.grid.minor.x  = element_blank()
)
